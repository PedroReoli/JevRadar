{
  "name": "jevradar",
  "version": "0.2.0-alpha.14",
  "private": true,
  "type": "module",
  "description": "Radar local-first de sentimento e sinais de mercado.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "node scripts/build-desktop.js",
    "build:web": "tsc -b && vite build",
    "check": "npm run check:types && npm run check:lint && npm run test:unit -- --run",
    "check:types": "tsc -b --pretty false",
    "check:lint": "eslint .",
    "check:rust": "node scripts/run-cargo.js check --manifest-path src-tauri/Cargo.toml",
    "check:all": "npm run check && npm run check:rust && npm run test:rust && npm run fmt:rust:check && npm run build:web",
    "test:rust": "node scripts/run-cargo.js test --manifest-path src-tauri/Cargo.toml",
    "test:e2e:desktop": "node scripts/e2e-desktop.mjs",
    "fmt:rust:check": "node scripts/run-cargo.js fmt --manifest-path src-tauri/Cargo.toml --check",
    "release:verify": "node scripts/verify-release.js && npm run check:all",
    "release:smoke": "npm run build && npm run test:e2e:desktop",
    "release:signed": "node scripts/build-signed-release.mjs",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "preview": "vite preview --host 127.0.0.1",
    "ops": "node scripts/ops.js",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "i18next": "26.6.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.10",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "29.1.1",
    "playwright-core": "^1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
